{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.agent.stack/schemas/job_record.schema.json",
  "title": "JobRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "discovered_at",
    "company",
    "title",
    "source",
    "job_url",
    "fit_score",
    "decision",
    "status"
  ],
  "properties": {
    "job_id": {"type": "string"},
    "discovered_at": {"type": "string", "format": "date-time"},
    "company": {"type": "string"},
    "title": {"type": "string"},
    "seniority": {"type": ["string", "null"]},
    "industry": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "remote_policy": {"type": ["string", "null"]},
    "base_salary_min_usd": {"type": ["number", "null"]},
    "base_salary_max_usd": {"type": ["number", "null"]},
    "total_comp_estimate_usd": {"type": ["number", "null"]},
    "compensation_confidence": {"type": ["string", "null"]},
    "posted_at": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "job_url": {"type": "string", "format": "uri"},
    "application_url": {"type": ["string", "null"], "format": "uri"},
    "ats": {"type": ["string", "null"]},
    "requisition_id": {"type": ["string", "null"]},
    "fit_score": {"type": "number"},
    "technical_score": {"type": ["number", "null"]},
    "leadership_score": {"type": ["number", "null"]},
    "industry_score": {"type": ["number", "null"]},
    "comp_score": {"type": ["number", "null"]},
    "geo_score": {"type": ["number", "null"]},
    "match_summary": {"type": ["string", "null"]},
    "missing_requirements": {"type": ["string", "null"]},
    "decision": {
      "type": "string",
      "enum": ["pursue", "watch", "reject", "needs_research"]
    },
    "status": {"type": "string"},
    "next_action": {"type": ["string", "null"]},
    "next_action_due": {"type": ["string", "null"]},
    "resume_version": {"type": ["string", "null"]},
    "cover_letter_path": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
