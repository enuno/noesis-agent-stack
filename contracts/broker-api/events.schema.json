{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/enuno/noesis-agent-stack/contracts/broker-api/events.schema.json",
  "title": "BrokerEventStreamEntry",
  "description": "Schema for a single event entry returned by GET /v1/jobs/{job_id}/events. Aligned with the canonical event envelope.",
  "type": "object",
  "required": [
    "event_id",
    "job_id",
    "timestamp",
    "type",
    "payload",
    "severity"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "Event type in dot notation.",
      "examples": [
        "broker.job.submitted",
        "broker.job.started",
        "broker.job.completed",
        "broker.job.cancelled",
        "broker.job.failed",
        "worker.tool.called",
        "worker.tool.failed",
        "worker.signal.emitted",
        "worker.checkpoint.saved",
        "platform.health.stalled",
        "palace.diary.written"
      ]
    },
    "source": {
      "type": "string",
      "description": "Component that emitted the event.",
      "examples": ["broker", "research-openclaw", "subconscious-openclaw", "main-hermes"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Event-specific payload."
    },
    "severity": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error", "critical"]
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  }
}
