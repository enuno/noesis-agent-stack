{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/enuno/noesis-agent-stack/contracts/orchestration/council-verdict.schema.json",
  "title": "CouncilVerdict",
  "description": "Advisory deliberation artifact produced by a CouncilSession. A verdict is evidence for the parent task's orchestrator/human acceptance path — never execution authorization, task acceptance, release approval, or spend permission. Deliberately contains no approval, acceptance, or lifecycle fields. Dissent is preserved structurally: positions are recorded independently before release and cannot be removed by synthesis. Usage/cost is recorded as observed vs estimated vs unknown, distinctly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "parent_task_id",
    "council_revision",
    "mode",
    "decision_question",
    "positions",
    "tally",
    "consensus",
    "acceptable_compromises",
    "kill_criteria",
    "concrete_next_step",
    "unresolved_questions",
    "usage",
    "session_metadata"
  ],
  "properties": {
    "schema_version": {"const": "noesis.council-verdict/v1"},
    "session_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": "string", "minLength": 1},
    "council_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_rev", "protocol_mode_version"],
      "properties": {
        "upstream_repo": {"const": "0xNyk/council-of-high-intelligence"},
        "upstream_rev": {"type": "string", "minLength": 7},
        "protocol_mode_version": {"type": "string", "minLength": 1}
      }
    },
    "mode": {"enum": ["duo", "quick", "triad", "full"]},
    "decision_question": {"type": "string", "minLength": 1},
    "positions": {
      "type": "array",
      "description": "Final per-seat positions, recorded independently. Synthesis cannot remove or rewrite a position; disagreement survives here even when consensus is declared. Completed verdicts (session_metadata.stop_condition null) require at least one position; partial results record the seats that blocked and leave this empty rather than fabricating entries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seat_id", "stance", "confidence_basis", "known_limitations"],
        "properties": {
          "seat_id": {"type": "string", "minLength": 1, "pattern": "^s[0-9]+$"},
          "profile": {"type": "string", "minLength": 1},
          "lens": {"type": "string"},
          "stance": {"type": "string", "minLength": 1},
          "evidence_labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "FACT": {"type": "array", "items": {"type": "string"}},
              "INFERENCE": {"type": "array", "items": {"type": "string"}},
              "ASSUMPTION": {"type": "array", "items": {"type": "string"}},
              "UNKNOWN": {"type": "array", "items": {"type": "string"}}
            }
          },
          "confidence_basis": {"type": "string", "minLength": 1},
          "known_limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "tally": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "threshold", "options"],
      "properties": {
        "method": {"const": "confidence_weighted_2of3"},
        "threshold": {
          "type": ["number", "null"],
          "description": "The weighted threshold applied. Null only in partial results where no tally was performed; completed verdicts must carry a number (enforced by the allOf conditional)."
        },
        "options": {
          "type": "array",
          "description": "Tally rows. Empty only in partial results where no tally was performed; completed verdicts require at least one row (enforced by the allOf conditional).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "weight", "backers"],
            "properties": {
              "option": {"type": "string", "minLength": 1},
              "weight": {"type": "number", "minimum": 0},
              "backers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "cleared_threshold": {"type": "boolean"}
            }
          }
        },
        "no_option_carried": {"type": "boolean"}
      }
    },
    "consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reached", "explanation"],
      "properties": {
        "reached": {"type": "boolean"},
        "position": {"type": ["string", "null"]},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "acceptable_compromises": {
      "type": "array",
      "items": {"type": "string"},
      "description": "What the verdict gives up, named explicitly. Empty array allowed only with explicit 'nothing traded' explanation carried in the synthesis_notes."
    },
    "kill_criteria": {
      "type": "array",
      "description": "Observable, dated falsification conditions. Each must be checkable without re-convening the council. Completed verdicts (session_metadata.stop_condition null) require at least one; partial results may record none rather than fabricating criteria.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "observable_by", "action_on_trigger"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "observable_by": {"type": "string", "format": "date-time"},
          "action_on_trigger": {"type": "string", "minLength": 1}
        }
      }
    },
    "concrete_next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "object", "owner", "due"],
      "description": "Exactly one action, artifact-producing verb, owned and dated. This is a PROPOSAL for the orchestrator/human — not an execution instruction. Council outputs propose actions; only the existing control plane and human approval mechanisms can authorize them. Authority-shaped verbs are rejected by a tripwire pattern below; that tripwire is a naming guard, not semantic authority isolation.",
      "properties": {
        "verb": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(?i)^(authorise|authorize|authorizes|authorised|authorized|approve|approves|approved|accept|accepts|accepted|acceptance|merge|merges|merged|deploy|deploys|deployed|release|releases|released|spend|spends|spent)$"
          },
          "description": "Advisory action verb. Authority-shaped verbs (authorize, approve, accept, merge, deploy, release, spend and inflections) are rejected as a tripwire; this is NOT comprehensive semantic enforcement."
        },
        "object": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "due": {"type": "string", "format": "date-time"}
      }
    },
    "unresolved_questions": {
      "type": "array",
      "description": "What the council does NOT know. UNKNOWN-labelled evidence must appear here.",
      "items": {"type": "string"}
    },
    "dissent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minority_report": {"type": "string"},
        "points_of_disagreement": {"type": "array", "items": {"type": "string"}}
      }
    },
    "synthesis_notes": {"type": "string"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "estimated", "unknown_fields"],
      "description": "Observed vs estimated vs unknown recorded distinctly. Never present estimates as observations.",
      "properties": {
        "observed": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "duration_s": {"type": "number", "minimum": 0}
          }
        },
        "estimated": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0}
          }
        },
        "unknown_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "session_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_size", "rounds_run", "fencing"],
      "properties": {
        "panel_size": {"type": "integer", "minimum": 1},
        "rounds_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Rounds that completed with full panel quorum. A Round-2 shortfall after a completed Round 1 reports 1, not 0; a Round-1 quorum shortfall reports 0."
        },
        "enforcement_breakdown": {"type": "object"},
        "chairman_failed_fallback": {"type": "boolean"},
        "fallbacks_triggered": {"type": "array", "items": {"type": "string"}},
        "stop_condition": {
          "type": ["string", "null"],
          "enum": ["split_verdict", "budget_exhausted", "lease_expiry",
                    "operator_cancel", "quorum_shortfall", null],
          "description": "Null or ABSENT on a completed session — absent is the pre-repair v1 shape and remains valid (backward compatibility: option A of the Phase D Repair-2 decision). Partial panels record why they stopped and MUST set a non-null value."
        },
        "fencing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_version", "epoch"],
          "properties": {
            "task_version": {"type": "integer", "minimum": 0},
            "epoch": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "session_metadata": {
            "anyOf": [
              {"not": {"required": ["stop_condition"]}},
              {"properties": {"stop_condition": {"type": "null"}}}
            ]
          }
        }
      },
      "then": {
        "description": "Completed verdict (stop_condition absent or null — both are the completed v1 shape): the original completed-verdict constraints apply unchanged.",
        "properties": {
          "positions": {"minItems": 1},
          "kill_criteria": {"minItems": 1},
          "tally": {
            "properties": {
              "options": {"minItems": 1},
              "threshold": {"type": "number"}
            }
          }
        }
      }
    }
  ]
}
