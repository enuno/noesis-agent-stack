# Runtime inference-routing enforcer configuration.
# Copy to the service environment and adjust paths for the deployment host.
# Default mode is observe: the gate records decisions but never blocks dispatch.

INFERENCE_ROUTING_MODE=observe
INFERENCE_ROUTING_FAIL_CLOSED=true
INFERENCE_ROUTING_POLICY_PATH=platform/inference-routing.yaml
INFERENCE_ROUTING_RECONCILIATION_PATH=platform/runtime-reconciliation.yaml
INFERENCE_ROUTING_MODELS_PATH=shared/models.yaml
INFERENCE_ROUTING_ALIASES_PATH=shared/model-aliases.yaml
INFERENCE_ROUTING_PROVIDER_POLICY_PATH=shared/provider-policies.yaml
INFERENCE_ROUTING_RISK_TIERS_PATH=platform/risk-tiers.yaml
INFERENCE_ROUTING_DECISION_LOG_PATH=/var/lib/noesis/routing-decisions.jsonl
INFERENCE_ROUTING_RELOAD_SECONDS=60
INFERENCE_ROUTING_ALLOWLIST=

# Emergency disable for mode=off only. Never set in normal operation.
# INFERENCE_ROUTING_EMERGENCY_DISABLE=true
